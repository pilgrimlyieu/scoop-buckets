{
    "version": "0.12.6",
    "description": "Vim-fork focused on extensibility and usability",
    "homepage": "https://neovim.io/",
    "license": {
        "identifier": "Apache-2.0,Vim",
        "url": "https://github.com/neovim/neovim/blob/master/LICENSE"
    },
    "suggest": {
        "vcredist": "extras/vcredist2022"
    },
    "architecture": {
        "64bit": {
            "url": "https://github.com/neovim/neovim/releases/download/v0.12.6/nvim-win64.zip",
            "hash": "4e12b7103b601ffc8f25954b4da100f339faa73dccb69a5b135e897fa3d893ed",
            "extract_dir": "nvim-win64"
        },
        "arm64": {
            "url": "https://github.com/neovim/neovim/releases/download/v0.12.6/nvim-win-arm64.zip",
            "hash": "2e58d259ffcc6145e5112ea02330126c6b57da09087bb9265fb2fa9aa10b485c",
            "extract_dir": "nvim-win-arm64"
        }
    },
    "bin": [
        "bin\\nvim.exe",
        "bin\\xxd.exe",
        "bin\\win32yank.exe"
    ],
    "checkver": {
        "url": "https://api.github.com/repos/neovim/neovim/releases/latest",
        "script": [
            "$release = $page | ConvertFrom-Json",
            "if ($release.draft -or $release.prerelease -or $release.tag_name -notmatch '^v(?<version>\\d+\\.\\d+\\.\\d+)$') { throw 'Expected a stable version tag.' }",
            "\"$($Matches.version)|$($release.tag_name)\""
        ],
        "regex": "^(?<version>[\\d.]+)\\|(?<tag>v[\\d.]+)$"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/neovim/neovim/releases/download/v$version/nvim-win64.zip"
            },
            "arm64": {
                "url": "https://github.com/neovim/neovim/releases/download/v$version/nvim-win-arm64.zip"
            }
        }
    },
    "##": "Based on ScoopInstaller/Main neovim; also exposes the bundled win32yank.exe."
}
